# Copy this file to .env.pg and replace the placeholder values.
# .env.pg is loaded by `npm run pg:deploy` / `npm run pg:start` (node --env-file=.env.pg).

# Activates the [pg] profile in package.json (cds.requires.db.kind = postgres)
CDS_ENV=pg

# PostgreSQL connection (mapped to cds.requires.db.credentials.*)
cds_requires_db_credentials_host=localhost
cds_requires_db_credentials_port=5432
cds_requires_db_credentials_user=your_db_user
cds_requires_db_credentials_password=your_db_password
cds_requires_db_credentials_database=catfood

# SSL (required by AWS RDS) is configured in package.json under cds.requires.db["[pg]"].credentials.ssl

# Auth0 login (read by express-openid-connect in srv/server.js)
# Auth0 dashboard > Applications > your Regular Web App > Settings
ISSUER_BASE_URL=https://your-tenant.au.auth0.com
CLIENT_ID=your_auth0_client_id
# Public URL of this app (http://localhost:4004 locally, the EB URL on AWS)
BASE_URL=http://localhost:4004
# Long random string used to encrypt the session cookie (at least 32 characters)
SECRET=replace_with_a_long_random_string_of_32_chars_or_more
